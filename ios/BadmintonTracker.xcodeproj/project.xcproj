    { "kind": "folder", "path": "BadmintonTrackerUITests", "target-membership": [ "BadmintonTrackerUITests" ] },
    { "kind": "folder", "path": "BadmintonTracker Watch App", "target-membership": [ "BadmintonTracker Watch App" ] },
    { "kind": "folder", "path": "BadmintonTracker Watch AppTests", "target-membership": [ "BadmintonTracker Watch AppTests" ] },
    { "kind": "folder", "path": "BadmintonTracker Watch AppUITests", "target-membership": [ "BadmintonTracker Watch AppUITests" ] },
    {
      "kind": "folder",
      "path": "BadmintonTrackerWidgets",
      "target-membership": [
        "BadmintonTrackerWidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "BadmintonTrackerWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "BadmintonTrackerWidgetsExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "BadmintonTrackerWidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/BadmintonTracker.app", "id": "3D3247EA3096055D00D18B46", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/BadmintonTrackerTests.xctest", "id": "3D3247F73096055E00D18B46", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/BadmintonTrackerUITests.xctest", "id": "3D3248013096055E00D18B46", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/BadmintonTracker Watch App.app", "id": "3D32480B3096055E00D18B46", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "BadmintonTracker/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
